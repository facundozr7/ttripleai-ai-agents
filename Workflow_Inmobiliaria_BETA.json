    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const originalText = $input.first().json.output;\n\n  if (typeof originalText !== 'string') {\n    return {\n      json: {\n        error: 'El campo \"text\" no existe o no es un texto',\n        original: originalText\n      }\n    };\n  }\n\n  let cleaned = originalText\n    .replace(/\\[Used tools:[\\s\\S]*?\\]\\]/g, '')   // Quitar el registro de uso de herramientas\n    .replace(/<[^>]*>/g, '')                     // Quitar HTML\n    .replace(/\\*/g, '')                          // 💥 NUEVO: Fulmina absolutamente todos los asteriscos\n    // 🛑 Eliminé la regla que borraba los saltos de línea (\\r\\n)\n    .replace(/\\t+/g, ' ')                        // Tabs a espacio\n    .replace(/[^\\p{L}\\p{N},.¿?¡!:\\-$\\s\\/\\p{Emoji}]+/gu, '') // Filtro estricto que deja vivir emojis\n    .replace(/ {2,}/g, ' ')                      // Normaliza espacios dobles (reemplaza el \\s+ para no romper los enters)\n    .trim();                                     // Quitar espacios extremos\n\n  return {\n    json: {\n      cleaned\n    }\n  };\n});"
      },
