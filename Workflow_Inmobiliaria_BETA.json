      "id": "fa2ea21a-6cf4-4293-b77a-61cf6f25cd6d",
      "name": "Datos a json"
    },
    {
      "parameters": {
        "jsCode": "// 1. Capturamos el texto crudo de la IA\nconst textoCrudo = $input.first().json.content.parts[0].text;\n\n// 2. Limpieza de formato JSON\nconst textoLimpio = textoCrudo.replace(/```json/g, '').replace(/```/g, '').trim();\nlet datos = JSON.parse(textoLimpio);\n\n// 3. Normalización del NOMBRE (Emisor)\n// Manejamos los dos nombres de clave que usás en tus prompts\nlet nombreClave = datos[\"Nombre del Emisor\"] ? \"Nombre del Emisor\" : (datos.Nombre ? \"Nombre\" : null);\n\nif (nombreClave && datos[nombreClave]) {\n  // Convertimos a MAYÚSCULAS y quitamos espacios extra al principio/final\n  datos[nombreClave] = datos[nombreClave].toString().toUpperCase().trim();\n}\n\n// 4. Normalización del MONTO\nif (datos.Monto) {\n  let m = datos.Monto.toString();\n  \n  // Quitamos símbolos, puntos de miles y dejamos solo números/comas\n  m = m.replace(/[^\\d,]/g, ''); \n  \n  // Lógica para que JavaScript entienda la coma como decimal\n  m = m.replace(',', '.');\n  \n  // Guardamos como número con 2 decimales\n  datos.Monto = parseFloat(m).toFixed(2);\n}\n\nreturn datos;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
