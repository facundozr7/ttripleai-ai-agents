      "parameters": {
        "jsCode": "const textoCrudo = $input.first().json.content.parts[0].text; // Ojo, esta ruta depende de tu nodo de IA, fijate de arrastrar la correcta\nconst textoLimpio = textoCrudo.replace(/```json/g, '').replace(/```/g, '').trim();\nreturn JSON.parse(textoLimpio);"
